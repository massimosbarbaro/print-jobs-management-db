    given-names: Massimo
    orcid: "https://orcid.org/0009-0006-8965-9013"
license: MIT
date-released: "1999-04-15"
repository-code: "https://github.com/massimosbarbaro/print-jobs-management-db"
keywords:
  - "db"
  - "printing"
  - "print jobs"
  - "estimates"
  - "packaging"
  - "legacy software"
